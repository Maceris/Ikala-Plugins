#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_GOOGLE_include_directive : require

// Turns volume_voxelize.comp's accumulators into bricks, see VolumeMath: a thread per voxel, the
// brick from z, writing each voxel's average color and its extinction, stored as the square root
// of its share of the most.
//
// Two kinds of extinction add up. Surfaces that aren't block faces, like plants, give the area times
// optical depth over twice the voxel's volume. A voxel inside a block is solid: one with block faces
// of its own, or one whose column has a block's top face above it before any bottom face (or, with
// none above in the brick, a bottom face below it before any top face), since blocks drop the faces
// their neighbors hide. A solid voxel stops light as a lone block would, through two of its faces,
// with the optical depth and color of its own faces or of the face that showed it was inside.
// Translucent blocks' faces fill nothing, since water drops its faces against the ground too: their
// voxel stops light as a ray crossing them straight on would, their optical depth over its volume.
//
// VolumeVoxelize clears the accumulators afterwards, since voxels read their columns' too.

#include "volume.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Accumulators {
    uint values[];
};

// Each of the batch's bricks' slot
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Slots {
    uint slots[];
};

layout(set = 0, binding = 0, rgba8) uniform restrict writeonly image3D atlas;

// Each slot's cell masks, see volume.glsl: cleared for the batch's slots before this runs
layout(std430, set = 0, binding = 2) buffer CellMasks {
    uvec4 cellMasks[];
};

// Each voxel's material, see volume.glsl: cleared for the batch's slots before this runs
layout(std430, set = 0, binding = 3) buffer VoxelMaterials {
    uint materialPairs[];
};

layout(push_constant) uniform ResolveConstants {
    Accumulators accumulators;
    Slots slotTable;
};

// Match volume_voxelize.comp and VolumeMath
const uint ACCUMULATORS = 9u;
const uint FACE_BITS = 5u;
const uint FACE_DEPTH = 6u;
const uint FACE_AREA = 7u;
const uint FACE_MATERIAL = 8u;
const float FIXED_POINT_SCALE = 4096.0;
// The face bits of a block's top and bottom
const uint TOP = 1u << 2u;
const uint BOTTOM = 1u << 3u;
// The face bit of a translucent block's face, on any side
const uint TRANSLUCENT_FACE = 1u << 6u;
// A voxel's volume, in cubic meters, and its size
const float VOXEL_VOLUME = 1.0;
const float VOXEL_SIZE = 1.0;
// Faces a ray crosses through a lone block
const float FACES_THROUGH = 2.0;

// Where a voxel's accumulators start
uint voxelIndex(uint brick, ivec3 voxel) {
    return (brick * uint(VOLUME_BRICK * VOLUME_BRICK * VOLUME_BRICK)
        + uint(voxel.x + VOLUME_BRICK * (voxel.y + VOLUME_BRICK * voxel.z))) * ACCUMULATORS;
}

void main()
{
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xy, gl_GlobalInvocationID.z % uint(VOLUME_BRICK));
    uint brick = gl_GlobalInvocationID.z / uint(VOLUME_BRICK);
    uint index = voxelIndex(brick, voxel);

    // The voxel whose faces make this one solid, if any
    uint ownBits = accumulators.values[index + FACE_BITS];
    bool solid = (ownBits & ~TRANSLUCENT_FACE) != 0u;
    uint source = index;
    if (!solid && ownBits == 0u) {
        bool decided = false;
        for (int y = voxel.y + 1; y < VOLUME_BRICK && !decided; ++y) {
            uint at = voxelIndex(brick, ivec3(voxel.x, y, voxel.z));
            uint bits = accumulators.values[at + FACE_BITS];
            if ((bits & (TOP | BOTTOM)) != 0u) {
                decided = true;
                solid = (bits & BOTTOM) == 0u;
                source = at;
            }
        }
        for (int y = voxel.y - 1; y >= 0 && !decided; --y) {
            uint at = voxelIndex(brick, ivec3(voxel.x, y, voxel.z));
            uint bits = accumulators.values[at + FACE_BITS];
            if ((bits & (TOP | BOTTOM)) != 0u) {
                decided = true;
                solid = (bits & TOP) == 0u;
                source = at;
            }
        }
    }

    float surfaceDepth = float(accumulators.values[index]) / FIXED_POINT_SCALE;
    float extinction = surfaceDepth / (2.0 * VOXEL_VOLUME);
    if (!solid && ownBits != 0u) {
        extinction += float(accumulators.values[index + FACE_DEPTH]) / FIXED_POINT_SCALE
            / VOXEL_VOLUME;
    }
    if (solid) {
        float faceArea = float(accumulators.values[source + FACE_AREA]);
        if (faceArea > 0.0) {
            float faceDepth = float(accumulators.values[source + FACE_DEPTH]) / faceArea;
            extinction += FACES_THROUGH * faceDepth / VOXEL_SIZE;
        }
    }
    uint colorFrom = accumulators.values[index + 4u] > 0u ? index : source;
    vec3 weighted = vec3(
        accumulators.values[colorFrom + 1u],
        accumulators.values[colorFrom + 2u],
        accumulators.values[colorFrom + 3u]);
    float weight = float(accumulators.values[colorFrom + 4u]);
    vec3 color = weight > 0.0 ? weighted / weight : vec3(0.0);
    // Solid voxels are stored in the upper half, with their faces' coverage, which marks them for
    // the walks that draw them as blocks; see-through ones as the square root of their share
    float coverage = 0.0;
    if (solid) {
        float faceArea = float(accumulators.values[source + FACE_AREA]);
        float faceDepth = faceArea > 0.0
            ? float(accumulators.values[source + FACE_DEPTH]) / faceArea : 0.0;
        coverage = 1.0 - exp(-faceDepth);
    }
    float stored = solid
        ? (VOLUME_FIRST_SOLID + round(coverage * (VOLUME_MAX_STORED - VOLUME_FIRST_SOLID)))
            / VOLUME_MAX_STORED
        : round(sqrt(clamp(extinction / VOLUME_MAX_EXTINCTION, 0.0, 1.0)) * VOLUME_MAX_SEE_THROUGH)
            / VOLUME_MAX_STORED;
    uint slot = slotTable.slots[brick];
    imageStore(atlas, volumeSlotOrigin(slot) + voxel, vec4(color, stored));
    // A solid voxel shows the material of its own faces, or of the face that showed it was inside
    uint material = solid ? accumulators.values[source + FACE_MATERIAL] : 0u;
    if (material != 0u) {
        uint at = slot * uint(VOLUME_BRICK * VOLUME_BRICK * VOLUME_BRICK)
            + uint(voxel.x + VOLUME_BRICK * (voxel.y + VOLUME_BRICK * voxel.z));
        atomicOr(materialPairs[at >> 1], (material & 0xFFFFu) << ((at & 1u) * 16u));
    }
    if (solid || extinction > 0.0) {
        uint cell = volumeCellIndex(voxel / VOLUME_CELL);
        uint bit = 1u << (cell & 31u);
        if (solid) {
            atomicOr(cellMasks[slot][cell >> 5], bit);
        }
        atomicOr(cellMasks[slot][2u + (cell >> 5)], bit);
    }
}
