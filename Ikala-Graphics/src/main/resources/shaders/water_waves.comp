#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

// Fills each wave climate's profiles for this frame, see WaterRender and WaveMath.profile: one
// thread per sample of a profile, x along it and y the climate's depth and direction, summing the
// climate's waves at that depth, each turned by the direction's own phase, each layer leaving out
// the waves shorter than its cutoff. Run twice: once for the long profiles, which sum the first
// WAVE_LONG_WAVES waves into one layer that serves every layer, and once for the short ones, which
// sum the rest. Each sample holds four sums, as half floats: the height,
// a cos (k p + phase); the slope along the profile, its derivative, -a k sin (k p + phase); how far
// the choppy waves move the surface along the profile, -a sin (k p + phase), as Gerstner and
// Tessendorf's choppy waves do; and how fast that changes, which the Jacobian is made of,
// a k cos (k p + phase), so dD/dp = -that. The phases come wrapped to a turn from the CPU, so they
// stay precise.

#include "water.glsl"

layout(local_size_x = 64) in;

// The waves a climate's samples hold, WaveMath.WAVES, which spaces the directions' phases
const int WAVE_SAMPLES = 142;

// One wave of a climate: its wavenumber, amplitude, phase now and wavelength
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WaveSampleList {
    vec4 waves[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) writeonly buffer WaveProfileOut {
    uvec2 values[];
};

layout(push_constant) uniform Constants {
    WaveSampleList samples;
    WaveProfileOut profiles;
    WaveClimateList climates;
    // How many waves each climate has, padded with zeros
    uint waveCount;
    // Nonzero to fill the long profiles rather than the short ones
    uint longPass;
};

// How much a direction's profile turns a wave's phase, see WaveMath.directionPhase: Jarzynski and
// Olano's PCG hash
float directionPhase(uint direction, uint wave) {
    uint state = (direction * uint(WAVE_SAMPLES) + wave) * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return 6.28318530718 * float(word >> 8) / 16777216.0;
}

void main() {
    uint sampleIndex = gl_GlobalInvocationID.x;
    uint climate = gl_GlobalInvocationID.y / uint(WAVE_DEPTHS * WAVE_DIRECTIONS);
    uint level = (gl_GlobalInvocationID.y / uint(WAVE_DIRECTIONS)) % uint(WAVE_DEPTHS);
    uint direction = gl_GlobalInvocationID.y % uint(WAVE_DIRECTIONS);
    uint depthClimate = climate * uint(WAVE_DEPTHS) + level;
    bool longWaves = longPass != 0u;
    uint sampleCount = longWaves ? uint(WAVE_LONG_SAMPLES) : uint(WAVE_PROFILE_SAMPLES);
    if (sampleIndex >= sampleCount || climates.climates[climate].levels[level] != int(level)) {
        return;
    }
    float distance = float(sampleIndex) / float(sampleCount)
        * (longWaves ? WAVE_LONG_LENGTH : WAVE_PROFILE_LENGTH);
    vec4 sums[WAVE_LAYERS];
    for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
        sums[layer] = vec4(0.0);
    }
    uint first = longWaves ? 0u : uint(WAVE_LONG_WAVES);
    uint end = longWaves ? uint(WAVE_LONG_WAVES) : waveCount;
    for (uint i = first; i < end; ++i) {
        vec4 wave = samples.waves[depthClimate * waveCount + i];
        if (wave.y <= 0.0) {
            continue;
        }
        float angle = wave.x * distance + wave.z + directionPhase(direction, i);
        float c = cos(angle);
        float s = sin(angle);
        vec4 value = wave.y * vec4(c, -wave.x * s, -s, wave.x * c);
        for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
            if (wave.w >= WAVE_LAYER_CUTOFFS[layer]) {
                sums[layer] += value;
            }
        }
    }
    if (longWaves) {
        // Every long wave is longer than every layer's cutoff
        profiles.values[waveLongBase(int(climate), int(level), int(direction)) + sampleIndex] =
            uvec2(packHalf2x16(sums[0].xy), packHalf2x16(sums[0].zw));
        return;
    }
    for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
        profiles.values[waveShortBase(int(climate), int(level), int(direction), layer)
            + sampleIndex] = uvec2(packHalf2x16(sums[layer].xy), packHalf2x16(sums[layer].zw));
    }
}
