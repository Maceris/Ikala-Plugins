#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

// Fills each wave climate's profiles for this frame, see WaterRender and WaveMath.profile: one
// thread per sample of a profile, x along it and y the climate's depth and direction, summing the
// climate's waves at that depth, each turned by the direction's own phase, each layer leaving out
// the waves shorter than its cutoff. Height is a cos (k p + phase) summed; the
// slope along the profile its derivative, -a k sin (k p + phase). The phases come wrapped to a turn
// from the CPU, so they stay precise.

#include "water.glsl"

layout(local_size_x = 64) in;

// The waves a climate's samples hold, WaveMath.WAVES, which spaces the directions' phases
const int WAVE_SAMPLES = 128;

// One wave of a climate: its wavenumber, amplitude, phase now and wavelength
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WaveSampleList {
    vec4 waves[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) writeonly buffer WaveProfileOut {
    vec2 values[];
};

layout(push_constant) uniform Constants {
    WaveSampleList samples;
    WaveProfileOut profiles;
    WaveClimateList climates;
    // How many waves each climate has, padded with zeros
    uint waveCount;
};

// How much a direction's profile turns a wave's phase, see WaveMath.directionPhase: Jarzynski and
// Olano's PCG hash
float directionPhase(uint direction, uint wave) {
    uint state = (direction * uint(WAVE_SAMPLES) + wave) * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return 6.28318530718 * float(word >> 8) / 16777216.0;
}

void main() {
    uint sampleIndex = gl_GlobalInvocationID.x;
    uint climate = gl_GlobalInvocationID.y / uint(WAVE_DEPTHS * WAVE_DIRECTIONS);
    uint level = (gl_GlobalInvocationID.y / uint(WAVE_DIRECTIONS)) % uint(WAVE_DEPTHS);
    uint direction = gl_GlobalInvocationID.y % uint(WAVE_DIRECTIONS);
    uint depthClimate = climate * uint(WAVE_DEPTHS) + level;
    if (sampleIndex >= uint(WAVE_PROFILE_SAMPLES)
            || climates.climates[climate].levels[level] != int(level)) {
        return;
    }
    float distance = float(sampleIndex) / float(WAVE_PROFILE_SAMPLES) * WAVE_PROFILE_LENGTH;
    vec2 sums[WAVE_LAYERS];
    for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
        sums[layer] = vec2(0.0);
    }
    for (uint i = 0; i < waveCount; ++i) {
        vec4 wave = samples.waves[depthClimate * waveCount + i];
        if (wave.y <= 0.0) {
            continue;
        }
        float angle = wave.x * distance + wave.z + directionPhase(direction, i);
        vec2 value = vec2(wave.y * cos(angle), -wave.y * wave.x * sin(angle));
        for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
            if (wave.w >= WAVE_LAYER_CUTOFFS[layer]) {
                sums[layer] += value;
            }
        }
    }
    for (int layer = 0; layer < WAVE_LAYERS; ++layer) {
        uint profile = (depthClimate * uint(WAVE_DIRECTIONS) + direction) * uint(WAVE_LAYERS)
            + uint(layer);
        profiles.values[profile * uint(WAVE_PROFILE_SAMPLES) + sampleIndex] = sums[layer];
    }
}
