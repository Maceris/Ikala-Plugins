#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

// The particle pool's bookkeeping between its passes, see ParticleUpdate: filling the free list at
// the start or when cleared, setting up a frame's simulation, and the billboards' draw after it.

#include "particles.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Constants {
    Control control;
    IndexList dead;
    // MODE_RESET, MODE_PREPARE or MODE_FINISH
    uint mode;
    // How many particles the pool holds
    uint capacity;
    // Which alive list the simulation reads; it writes the other
    uint current;
};

// Every particle free, every list empty; one thread per particle
const uint MODE_RESET = 0;
// The simulation's dispatch from the alive count, the list it writes emptied; one thread
const uint MODE_PREPARE = 1;
// The billboards' draw from the list just written; one thread
const uint MODE_FINISH = 2;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (mode == MODE_RESET) {
        if (index < capacity) {
            dead.indices[index] = index;
        }
        if (index == 0) {
            control.alive[0] = 0;
            control.alive[1] = 0;
            control.dead = int(capacity);
            control.dropped = 0;
            control.dispatchArgs = uvec4(0, 1, 1, 0);
            control.drawArgs = uvec4(BILLBOARD_VERTICES, 0, 0, 0);
        }
        return;
    }
    if (index != 0) {
        return;
    }
    if (mode == MODE_PREPARE) {
        uint alive = control.alive[current];
        control.dispatchArgs = uvec4((alive + PARTICLE_WORKGROUP - 1) / PARTICLE_WORKGROUP, 1, 1, 0);
        control.alive[1 - current] = 0;
        control.dropped = 0;
    } else {
        control.drawArgs = uvec4(BILLBOARD_VERTICES, control.alive[1 - current], 0, 0);
    }
}
