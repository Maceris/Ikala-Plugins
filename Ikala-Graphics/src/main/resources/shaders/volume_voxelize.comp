#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : require

// Voxelizes sections' cut out and translucent meshes into volume bricks, see VolumeBricks and
// VolumeMath: one thread per triangle, found in the job list by its index, read straight from the
// baked geometry buffers. The triangle's area is spread over the voxels it passes through by
// sample points spread evenly over it, each adding its share of area times the surface's optical
// depth, and its share of the weighted color, to fixed-point accumulators. volume_resolve.comp
// turns them into the brick.
//
// A face of a block, lying on a voxel boundary and facing along an axis, instead marks the voxel
// it belongs to as solid on that side, with its optical depth: blocks drop the faces their
// neighbors hide, so the resolve fills the voxels between a cut out block's top and bottom faces,
// rather than leaving a canopy a hollow shell. A translucent block's faces only mark their own
// voxel: water drops its faces against the ground too, so filling below its top would fill the
// ground.

#include "baked_mesh.glsl"
#include "color.glsl"
#include "material.glsl"
#include "volume.glsl"

layout(local_size_x = 64) in;

// One section mesh into one brick of this batch
struct Job {
    // The index of its first triangle among all of this dispatch's
    uint firstTriangle;
    // Where its indices start in the index buffer
    uint firstIndex;
    // Where its vertices start in the vertex buffer, which its indices count from
    int vertexOffset;
    // How many triangles it has
    uint triangleCount;
    // Which of this batch's bricks it goes into
    uint brick;
    // Nonzero for translucent blocks, whose faces don't fill the blocks between them
    uint translucent;
    uint _padding1;
    uint _padding2;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Jobs {
    Job jobs[];
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Materials {
    Material materials[];
};

// ACCUMULATORS values per voxel of each brick: area times optical depth, then the weighted
// color's red, green, blue, then the weight; then the block faces' bits, one per side, their area
// times optical depth, and their area; then a cut out face's material, plus 1
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Accumulators {
    uint values[];
};

layout(set = 0, binding = 0) uniform sampler2D bindlessTextures[];

layout(push_constant) uniform VoxelizeConstants {
    Jobs jobs;
    BakedWords vertices;
    BakedWords indices;
    Materials materialTable;
    Accumulators accumulators;
    uint jobCount;
    uint triangleCount;
    uint materialCount;
};

// Match VolumeMath and VolumeVoxelize
const uint ACCUMULATORS = 9u;
const uint FACE_BITS = 5u;
const uint FACE_DEPTH = 6u;
const uint FACE_AREA = 7u;
// A cut out block face's material, plus 1, the largest when faces differ
const uint FACE_MATERIAL = 8u;
// How near a face's normal is to an axis, and its corners to a voxel boundary, to count as a
// block's face
const float AXIS_ALIGNED = 0.99;
const float ON_BOUNDARY = 1.0 / 256.0;
// The face bit of a translucent block's face, on any side
const uint TRANSLUCENT_FACE = 1u << 6u;
const float FIXED_POINT_SCALE = 4096.0;
const float MAX_OPACITY = 0.98;
// How many sample points a triangle gets per square meter, and the most it gets
const float SAMPLES_PER_SQUARE_METER = 16.0;
const uint MAX_SAMPLES = 64u;
// How much of the way to the triangle's middle each sample point moves: R2's first point falls on
// an edge, and a point on a block face's outer edge would floor into the next voxel over
const float INSET = 1.0 / 64.0;

void main()
{
    uint triangle = gl_GlobalInvocationID.x;
    if (triangle >= triangleCount) {
        return;
    }
    // The last job starting at or before this triangle
    uint low = 0;
    uint high = jobCount - 1;
    while (low < high) {
        uint mid = (low + high + 1) / 2;
        if (jobs.jobs[mid].firstTriangle <= triangle) {
            low = mid;
        } else {
            high = mid - 1;
        }
    }
    Job job = jobs.jobs[low];
    uint local = triangle - job.firstTriangle;
    if (local >= job.triangleCount) {
        return;
    }
    uint a = uint(job.vertexOffset) + indices.words[job.firstIndex + local * 3];
    uint b = uint(job.vertexOffset) + indices.words[job.firstIndex + local * 3 + 1];
    uint c = uint(job.vertexOffset) + indices.words[job.firstIndex + local * 3 + 2];
    vec3 p0 = bakedPosition(vertices, a);
    vec3 p1 = bakedPosition(vertices, b);
    vec3 p2 = bakedPosition(vertices, c);
    vec3 normal = bakedNormal(vertices, a);
    int axis = abs(normal.x) > AXIS_ALIGNED ? 0
        : abs(normal.y) > AXIS_ALIGNED ? 1
        : abs(normal.z) > AXIS_ALIGNED ? 2 : -1;
    bool blockFace = axis >= 0
        && abs(p0[axis] - round(p0[axis])) < ON_BOUNDARY
        && abs(p1[axis] - p0[axis]) < ON_BOUNDARY
        && abs(p2[axis] - p0[axis]) < ON_BOUNDARY;
    // From a point on the face into the block it belongs to, and which side of it the face is
    vec3 inward = vec3(0.0);
    uint sideBit = 0u;
    if (blockFace) {
        float outward = sign(normal[axis]);
        inward[axis] = -0.5 * outward;
        sideBit = job.translucent != 0u
            ? TRANSLUCENT_FACE
            : 1u << uint(axis * 2 + (outward > 0.0 ? 0 : 1));
    }
    float area = 0.5 * length(cross(p1 - p0, p2 - p0));
    if (area <= 0.0 || materialCount == 0u) {
        return;
    }

    // The surface's average color and opacity: its texture's smallest mip, as the scene and
    // transparency stages take the texture over the base color
    uint materialIndex = min(bakedMaterial(vertices, a), materialCount - 1u);
    Material material = materialTable.materials[materialIndex];
    vec4 color = material.baseColor;
    if (material.textureIndex > 0) {
        color = textureLod(bindlessTextures[nonuniformEXT(material.textureIndex)], vec2(0.5), 64.0);
    }
    float opacity = clamp(color.a, 0.0, MAX_OPACITY);
    if (opacity <= 0.0) {
        return;
    }
    float opticalDepth = -log(1.0 - opacity);
    vec3 linear = sRGBToLinear(color.rgb);

    uint samples = clamp(uint(ceil(area * SAMPLES_PER_SQUARE_METER)), 1u, MAX_SAMPLES);
    float share = area / float(samples);
    uint depth = uint(share * opticalDepth * FIXED_POINT_SCALE + 0.5);
    float weight = share * opacity;
    uvec3 weighted = uvec3(weight * linear * FIXED_POINT_SCALE + 0.5);
    uint weightBits = uint(weight * FIXED_POINT_SCALE + 0.5);
    uint brickBase = job.brick * uint(VOLUME_BRICK * VOLUME_BRICK * VOLUME_BRICK);
    vec3 middle = (p0 + p1 + p2) / 3.0;
    for (uint i = 0u; i < samples; ++i) {
        // Roberts' R2 sequence, folded into the triangle
        vec2 uv = fract(vec2(0.5) + float(i) * vec2(0.7548776662, 0.5698402910));
        if (uv.x + uv.y > 1.0) {
            uv = 1.0 - uv;
        }
        vec3 onFace = p0 + uv.x * (p1 - p0) + uv.y * (p2 - p0);
        vec3 point = mix(onFace, middle, INSET) + inward;
        ivec3 voxel = clamp(ivec3(floor(point)), ivec3(0), ivec3(VOLUME_BRICK - 1));
        uint index = (brickBase
            + uint(voxel.x + VOLUME_BRICK * (voxel.y + VOLUME_BRICK * voxel.z))) * ACCUMULATORS;
        if (blockFace) {
            atomicOr(accumulators.values[index + FACE_BITS], sideBit);
            atomicAdd(accumulators.values[index + FACE_DEPTH], depth);
            atomicAdd(accumulators.values[index + FACE_AREA], uint(share * FIXED_POINT_SCALE + 0.5));
            if (job.translucent == 0u) {
                atomicMax(accumulators.values[index + FACE_MATERIAL], materialIndex + 1u);
            }
        } else {
            atomicAdd(accumulators.values[index], depth);
        }
        atomicAdd(accumulators.values[index + 1u], weighted.r);
        atomicAdd(accumulators.values[index + 2u], weighted.g);
        atomicAdd(accumulators.values[index + 3u], weighted.b);
        atomicAdd(accumulators.values[index + 4u], weightBits);
    }
}
