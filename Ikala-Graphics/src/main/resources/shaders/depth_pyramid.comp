#version 460
#extension GL_EXT_nonuniform_qualifier : enable

// Builds one level of the depth pyramid the late culling pass tests against. Each texel keeps the
// farthest depth under it, from the depth buffer for level 0 and from the level before for the
// rest. Each level is half the size of the one before, rounded down, so when the level before is
// odd sized, the last texel of a row or column also takes in the one left over.
// DepthPyramidMath has the same thing in Java, with tests.

// The level being written
layout(set = 0, binding = 0, r32f) uniform writeonly image2D destination;

// Every level, to read the one before
layout(set = 0, binding = 1) uniform sampler2D pyramid;

layout(set = 1, binding = 0) uniform sampler2D bindlessTextures[];

layout(push_constant) uniform Constants {
    // The size of what is read, the depth buffer or the level before
    ivec2 sourceSize;
    // The size of the level being written
    ivec2 destinationSize;
    // The level being written
    int level;
    // The bindless index of this frame's depth buffer
    uint depthIndex;
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float source(ivec2 texel)
{
    if (level == 0) {
        return texelFetch(bindlessTextures[depthIndex], texel, 0).r;
    }
    return texelFetch(pyramid, texel, level - 1).r;
}

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, destinationSize))) {
        return;
    }
    ivec2 first = min(texel * 2, sourceSize - 1);
    ivec2 last = ivec2(
        texel.x == destinationSize.x - 1 ? sourceSize.x - 1 : texel.x * 2 + 1,
        texel.y == destinationSize.y - 1 ? sourceSize.y - 1 : texel.y * 2 + 1);
    // Depth is 0 at the near plane and 1 at the far plane
    float farthest = 0.0;
    for (int y = first.y; y <= last.y; ++y) {
        for (int x = first.x; x <= last.x; ++x) {
            farthest = max(farthest, source(ivec2(x, y)));
        }
    }
    imageStore(destination, texel, vec4(farthest));
}
