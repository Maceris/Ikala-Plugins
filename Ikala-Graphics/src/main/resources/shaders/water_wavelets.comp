#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// Steps the wave amplitude grid around the camera, see WaveletMath and WaterRender: one thread per
// cell, for each band and direction: the amplitude upstream along the direction, at the band's
// speed, read from the last step's grid (past it, open water: a wind factor of 1 and no ripples);
// where the way upstream reaches land, the amplitude of the direction the shore reflects into this
// one, here; then a little spread into the neighboring directions; the wind building its waves back
// toward 1 and ripples dying away; and the disturbances' ripples, leaving each as a ring. Land
// holds no waves. Cells are kept by world cell, wrapping around the grid, so the grid scrolls with
// the camera without moving anything. Where crests break, water falls in and the water is
// disturbed, it records hits for the particles' next splash pass to throw up spray, mist and
// droplets, see ParticleUpdate.

#include "water.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Each cell's water, by world cell wrapping around the grid: 0 for land, else its wind climate plus
// WAVE_MASK_CLIMATE_BASE, -1 for none; how fast it flows along x and z, in meters a second; and how
// deep it is, in meters
// ... then, in the second vec4, how far water falls onto it from a higher neighbor, in meters, and
// its surface's height at rest, in the world
struct WaveMaskCell {
    vec4 cell;
    vec4 more;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WaveMaskList {
    WaveMaskCell cells[];
};

// Where water falls onto a cell: how fast it makes foam, per second, up to covering the cell, and
// how fast it raises ripples, in meters a second per square root meter of the fall: a falling sheet
// churns the water it lands in into a patch of foam and sends ripples off it
const float WAVE_PLUNGE_FOAM = 2.0;
const float WAVE_PLUNGE_RIPPLE = 0.004;

// How many hits for the particles a cell records a second: spray where its crests all break, and
// mist and droplets where water falls in, per square root meter of the fall. Each hit throws up its
// effect's burst, see WaterEffects.
const float WAVE_SPRAY_RATE = 12.0;
const float WAVE_PLUNGE_MIST_RATE = 1.5;
const float WAVE_PLUNGE_SPLASH_RATE = 3.0;

// How many droplet hits a disturbance records, per meter of its ripples' height and meter of its
// radius, and the most: a footstep throws up a hit's worth, a boulder falling in a few dozen
const float WAVE_DISTURBANCE_SPLASHES = 100.0;
const uint WAVE_MOST_DISTURBANCE_SPLASHES = 32;

// The most hits a cell records in a step, so a long step doesn't flood the list
const uint WAVE_MOST_CELL_HITS = 4;

// The particles' water links, see particles.glsl
const uint WATER_LINK_SPRAY = 16;
const uint WATER_LINK_MIST = 17;
const uint WATER_LINK_SPLASH = 18;

// The most hits the water records in a step, ParticleMath.MAX_WATER_HITS
const uint MAX_WATER_HITS = 2048;

// A hit for the particles' splash pass: where, relative to the camera, and which water link
struct WaterHit {
    vec3 position;
    uint link;
};

// The hits, then how many drops landed in each cell since the last step, by world cell, see
// ParticleMath.WATER_DROPS
layout(buffer_reference, std430, buffer_reference_align = 16) buffer WaterHitList {
    WaterHit hits[MAX_WATER_HITS];
    uint drops[];
};

// How long the rain a cell felt takes to fade from its smoothed rate, in seconds: long enough to
// even out the few drops a cell gets a frame
const float WAVE_RAIN_SMOOTHING = 1.0;

// How many hits the list holds, in the particles' control buffer
layout(buffer_reference, std430, buffer_reference_align = 4) buffer WaterHitCount {
    uint count;
};

// Gravity, in meters a second squared: in shallow water waves go at sqrt(g h)
const float GRAVITY = 9.81;

// What a water cell's first mask value is over its wind climate, see WaveGrid
const int WAVE_MASK_CLIMATE_BASE = 2;

// This frame's wave paints, see WaterRegistry.WavePaint: x and z relative to the grid's corner in
// cells, radius in cells and strength, then the way its waves go, x and z
struct WavePaint {
    vec4 place;
    vec4 way;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WavePaintList {
    WavePaint paints[];
};

// This frame's disturbances: x and z relative to the grid's corner in cells, radius in cells, and
// strength, the ripples' height in meters
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WaveDisturbanceList {
    vec4 disturbances[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer WaveGridOut {
    float values[];
};

layout(push_constant) uniform Constants {
    WaveGridList last;
    WaveGridOut next;
    WaveMaskList mask;
    WaveDisturbanceList disturbanceList;
    // The grid's corner now and at the last step, in world cells
    ivec2 corner;
    ivec2 lastCorner;
    // How long the step is, in seconds
    float seconds;
    // How many disturbances there are, and nonzero if the last step's grid can be read
    int disturbanceCount;
    int lastValid;
    WaveClimateList climates;
    WavePaintList paintList;
    int paintCount;
    WaveProfileList profiles;
    // The grid's corner relative to the camera, in meters, where the profiles are worked out from
    vec2 cornerRender;
    // The camera's height, which hits are kept relative to, and this step's random seed
    float cameraHeight;
    uint seed;
    // Where hits go, and their count; 0 for no particles
    uvec2 hitListAddress;
    uvec2 hitCountAddress;
};

// A well mixed 32-bit hash (Jarzynski and Olano's PCG hash, JCGT 2020), as particles.glsl's
uint waveHash(uint value) {
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// A number from 0 to 1 from a hash, advancing it
float waveRandom(inout uint state) {
    state = waveHash(state);
    return float(state >> 8) / 16777216.0;
}

// Record a hit for the particles, relative to the camera
void recordHit(vec3 position, uint link) {
    uint at = atomicAdd(WaterHitCount(hitCountAddress).count, 1u);
    if (at < MAX_WATER_HITS) {
        WaterHitList(hitListAddress).hits[at] = WaterHit(position, link);
    }
}

// Record as many hits as a rate gives over the step, on average, at random over a cell at a height
// relative to the camera
void recordHits(float perSecond, uint link, vec2 corner, float height, inout uint state) {
    float expected = perSecond * seconds;
    uint count = uint(expected);
    if (waveRandom(state) < fract(expected)) {
        ++count;
    }
    for (uint i = 0; i < min(count, WAVE_MOST_CELL_HITS); ++i) {
        vec2 at = corner + vec2(waveRandom(state), waveRandom(state)) * WAVE_CELL_SIZE;
        recordHit(vec3(at.x, height, at.y), link);
    }
}

// This cell's climate's share of the wind's waves in each direction, what the wind builds them back
// toward and open water holds; none without wind
float windShares[WAVE_DIRECTIONS];


// Whether a world cell holds water, as far as the grid knows; land past it
float waterAt(ivec2 cell) {
    ivec2 local = cell - corner;
    if (any(lessThan(local, ivec2(0))) || any(greaterThanEqual(local, ivec2(WAVE_GRID_SIZE)))) {
        return 1.0;
    }
    return mask.cells[waveGridSlot(cell)].cell.x > 0.0 ? 1.0 : 0.0;
}

// The last step's amplitude at a point in world cells, between the four nearest cells' middles;
// open water's past the last grid
float lastAt(vec2 point, int band, int direction) {
    vec2 local = point - vec2(lastCorner) - 0.5;
    if (lastValid == 0 || any(lessThan(local, vec2(0.0)))
            || any(greaterThan(local, vec2(float(WAVE_GRID_SIZE - 1))))) {
        return band == WAVE_WIND_BAND ? windShares[direction] : 0.0;
    }
    ivec2 base = ivec2(floor(local)) + lastCorner;
    vec2 f = fract(local);
    int channel = band * WAVE_DIRECTIONS + direction;
    float v00 = last.values[waveGridSlot(base) * WAVE_CELL_VALUES + channel];
    float v10 = last.values[waveGridSlot(base + ivec2(1, 0)) * WAVE_CELL_VALUES + channel];
    float v01 = last.values[waveGridSlot(base + ivec2(0, 1)) * WAVE_CELL_VALUES + channel];
    float v11 = last.values[waveGridSlot(base + ivec2(1, 1)) * WAVE_CELL_VALUES + channel];
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

// One Catmull-Rom spline's weights for the four samples around a fraction
vec4 catmullRom(float f) {
    float f2 = f * f;
    float f3 = f2 * f;
    return 0.5 * vec4(-f3 + 2.0 * f2 - f, 3.0 * f3 - 5.0 * f2 + 2.0, -3.0 * f3 + 4.0 * f2 + f,
        f3 - f2);
}

// The last step's amplitude at a point, like lastAt but through the sixteen nearest cells, kept
// between the four nearest: a short ring carried a fraction of a cell each step blurs away with
// lastAt's straight lines, all the faster in a current
float lastAtSharp(vec2 point, int band, int direction) {
    vec2 local = point - vec2(lastCorner) - 0.5;
    if (lastValid == 0 || any(lessThan(local, vec2(1.0)))
            || any(greaterThan(local, vec2(float(WAVE_GRID_SIZE - 2))))) {
        return lastAt(point, band, direction);
    }
    ivec2 base = ivec2(floor(local)) + lastCorner;
    vec2 f = fract(local);
    int channel = band * WAVE_DIRECTIONS + direction;
    float v00 = last.values[waveGridSlot(base) * WAVE_CELL_VALUES + channel];
    float v10 = last.values[waveGridSlot(base + ivec2(1, 0)) * WAVE_CELL_VALUES + channel];
    float v01 = last.values[waveGridSlot(base + ivec2(0, 1)) * WAVE_CELL_VALUES + channel];
    float v11 = last.values[waveGridSlot(base + ivec2(1, 1)) * WAVE_CELL_VALUES + channel];
    float low = min(min(v00, v10), min(v01, v11));
    float high = max(max(v00, v10), max(v01, v11));
    // Most of the grid is calm, where the straight lines are as good
    if (high - low <= WAVE_FAINTEST) {
        return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
    }
    vec4 wx = catmullRom(f.x);
    vec4 wy = catmullRom(f.y);
    float sum = 0.0;
    for (int y = 0; y < 4; ++y) {
        float row = 0.0;
        for (int x = 0; x < 4; ++x) {
            row += wx[x] * last.values[waveGridSlot(base + ivec2(x - 1, y - 1))
                * WAVE_CELL_VALUES + channel];
        }
        sum += wy[y] * row;
    }
    return clamp(sum, low, high);
}

// The direction a shore of some outward normal reflects into a direction, see
// WaveletMath.reflectedFrom
int reflectedFrom(int direction, vec2 normal) {
    vec2 d = waveDirection(direction);
    vec2 mirrored = d - 2.0 * dot(d, normal) * normal;
    int nearest = int(round(atan(mirrored.y, mirrored.x) / 6.28318530718 * float(WAVE_DIRECTIONS)));
    return ((nearest % WAVE_DIRECTIONS) + WAVE_DIRECTIONS) % WAVE_DIRECTIONS;
}

void main() {
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(local, ivec2(WAVE_GRID_SIZE)))) {
        return;
    }
    ivec2 cell = corner + local;
    int slot = waveGridSlot(cell);
    // The drops that landed here since the last step, taken in as rain
    float drops = 0.0;
    if (any(notEqual(hitListAddress, uvec2(0)))) {
        WaterHitList list = WaterHitList(hitListAddress);
        // Before the first step the counts hold whatever the buffer did
        drops = lastValid != 0 ? float(list.drops[slot]) : 0.0;
        list.drops[slot] = 0u;
    }
    if (waterAt(cell) <= 0.0) {
        for (int i = 0; i < WAVE_CELL_VALUES; ++i) {
            next.values[slot * WAVE_CELL_VALUES + i] = 0.0;
        }
        return;
    }
    vec2 middle = vec2(cell) + 0.5;
    vec4 here = mask.cells[slot].cell;
    float plunge = mask.cells[slot].more.x;
    bool hits = any(notEqual(hitCountAddress, uvec2(0)));
    uint state = waveHash(seed ^ waveHash(uint(slot)));
    vec2 cellCorner = cornerRender + vec2(local) * WAVE_CELL_SIZE;
    float rest = mask.cells[slot].more.y - cameraHeight;
    int climate = int(here.x + 0.5) - WAVE_MASK_CLIMATE_BASE;
    float peak = climate >= 0 ? climates.climates[climate].peak.x : 0.0;
    for (int b = 0; b < WAVE_DIRECTIONS; ++b) {
        windShares[b] = peak > 0.0 ? climates.climates[climate].amplitudes[b] / peak : 0.0;
    }
    // The paint covering this cell most, if any
    float paintWeight = 0.0;
    WavePaint paint;
    for (int p = 0; p < paintCount; ++p) {
        WavePaint candidate = paintList.paints[p];
        float weight = 1.0 - length(vec2(local) + 0.5 - candidate.place.xy) / candidate.place.z;
        if (weight > paintWeight) {
            paintWeight = weight;
            paint = candidate;
        }
    }
    paintWeight = smoothstep(0.0, 1.0, paintWeight);
    // The current carries every band's waves along with it
    vec2 carried = here.yz / WAVE_CELL_SIZE * seconds;
    // The way out of the land nearby, toward the water
    vec2 shore = vec2(waterAt(cell + ivec2(1, 0)) - waterAt(cell - ivec2(1, 0)),
        waterAt(cell + ivec2(0, 1)) - waterAt(cell - ivec2(0, 1)));
    float diffusion = WAVE_ANGULAR_DIFFUSION * seconds;
    // The wind band's new values, for the cell's crests
    float windValues[WAVE_DIRECTIONS];
    for (int band = 0; band < WAVE_BANDS; ++band) {
        // Shallow water slows the wind's long waves to sqrt(g h)
        float speed = (band == WAVE_WIND_BAND
                ? min(WAVE_WIND_SPEED, sqrt(GRAVITY * max(here.w, 0.0)))
                : WAVE_RIPPLE_SPEED)
            / WAVE_CELL_SIZE * seconds;
        float moved[WAVE_DIRECTIONS];
        for (int b = 0; b < WAVE_DIRECTIONS; ++b) {
            vec2 upstream = middle - speed * waveDirection(b) - carried;
            if (waterAt(ivec2(floor(upstream))) <= 0.0) {
                vec2 normal = dot(shore, shore) > 0.0 ? normalize(shore) : -waveDirection(b);
                moved[b] = WAVE_REFLECTION * lastAt(middle, band, reflectedFrom(b, normal));
            } else {
                moved[b] = band == WAVE_WIND_BAND
                    ? lastAt(upstream, band, b) : lastAtSharp(upstream, band, b);
            }
        }
        for (int b = 0; b < WAVE_DIRECTIONS; ++b) {
            // The spread into the neighboring directions acts on the wind band's departure from
            // the wind's own spreading, so open water keeps the climate's waves exactly
            int previous = (b + WAVE_DIRECTIONS - 1) % WAVE_DIRECTIONS;
            int following = (b + 1) % WAVE_DIRECTIONS;
            bool wind = band == WAVE_WIND_BAND;
            float base = wind ? windShares[b] : 0.0;
            float before = moved[previous] - (wind ? windShares[previous] : 0.0);
            float after = moved[following] - (wind ? windShares[following] : 0.0);
            float value = base + (1.0 - 2.0 * diffusion) * (moved[b] - base)
                + diffusion * (before + after);
            if (band == WAVE_WIND_BAND) {
                value += (windShares[b] - value) * (1.0 - exp(-seconds / WAVE_WIND_RECOVERY));
                if (paintWeight > 0.0) {
                    float along = max(0.0, dot(waveDirection(b), paint.way.xy));
                    value = mix(value, paint.place.w * pow(along, WAVE_PAINT_SPREAD), paintWeight);
                }
                windValues[b] = value;
            } else {
                value *= exp(-seconds / WAVE_RIPPLE_LIFETIME);
                for (int d = 0; d < disturbanceCount; ++d) {
                    vec4 disturbance = disturbanceList.disturbances[d];
                    vec2 offset = vec2(local) + 0.5 - disturbance.xy;
                    float distance = length(offset);
                    if (distance >= disturbance.z) {
                        continue;
                    }
                    float fade = 1.0 - distance / disturbance.z;
                    float outward = distance > 0.0
                        ? max(0.0, dot(waveDirection(b), offset / distance)) : 1.0;
                    value += disturbance.w * fade * outward;
                }
                value += WAVE_PLUNGE_RIPPLE * sqrt(plunge) * seconds;
                // Ripples too faint to draw are gone, which keeps calm water calm for lastAtSharp
                value = value > WAVE_FAINTEST ? value : 0.0;
            }
            next.values[slot * WAVE_CELL_VALUES + band * WAVE_DIRECTIONS + b] = value;
        }
    }
    // The foam breaking crests leave: carried by the current, fading over WAVE_FOAM_LIFETIME, and
    // made where the cell's crests break, as in War Thunder's ocean (Tcheblokov 2015): where the
    // longest waves' Jacobian at the cell's middle, which a cell samples well, falls under a
    // threshold of their own. Whitecaps break on the steepest of the big crests, the short waves
    // riding them steepened there, which summing the short waves' spread as if independent would
    // miss: so the long waves' threshold is set to be crossed as often as the whole spectrum's,
    // 1 - sqrt(their variance / the whole's) (1 - the climate's), and foam gathers on big crests and
    // trails behind them, settling over the wind's own waves at the rest of the whitecaps' measured
    // coverage, see WaveMath.ACTIVE_WHITECAP_SHARE
    float foam = lastAt(middle - carried, WAVE_FOAM_BAND, 0) * exp(-seconds / WAVE_FOAM_LIFETIME);
    // Without long waves, a light breeze's or a small pool's, nothing breaks
    if (climate >= 0 && climates.climates[climate].peak.w > 0.0) {
        vec4 extra = climates.climates[climate].peak;
        vec2 render = cornerRender + (vec2(local) + 0.5) * WAVE_CELL_SIZE;
        int depthLevel = min(int(floor(waveDepthLevel(max(here.w, 0.0)) + 0.5)), WAVE_DEPTHS - 1);
        int level = climates.climates[climate].levels[depthLevel];
        vec3 sums = vec3(0.0);
        // The long waves' height at the cell's middle, where spray leaves the crests
        float crestHeight = 0.0;
        for (int b = 0; b < WAVE_DIRECTIONS; ++b) {
            float amplitude = peak * windValues[b];
            if (amplitude <= WAVE_FAINTEST) {
                continue;
            }
            vec2 direction = waveDirection(b);
            float along = dot(render, direction) + climates.climates[climate].offsets[b];
            vec4 profile = waveProfile(profiles, climate, level, b, WAVE_LAST_LAYER, along);
            sums += amplitude * profile.w * vec3(direction.x * direction.x,
                direction.y * direction.y, direction.x * direction.y);
            crestHeight += amplitude * profile.x;
        }
        float squeeze = determinant(waveJacobian(sums));
        float threshold = 1.0 - sqrt(extra.w / max(extra.z, 1e-12)) * (1.0 - extra.y);
        // As sharp as the long waves' own spread allows, so breaking keeps to the crests
        float edge = WAVE_FOAM_CREST_EDGE * WAVE_CHOP * sqrt(extra.w);
        float breaking = waveNormalCdf((threshold - squeeze) / edge);
        foam += breaking * (1.0 - WAVE_ACTIVE_WHITECAP_SHARE) / WAVE_ACTIVE_WHITECAP_SHARE
            * seconds / WAVE_FOAM_LIFETIME;
        if (hits && breaking > 0.0) {
            // Torn off the top of the breaking crest
            recordHits(breaking * WAVE_SPRAY_RATE, WATER_LINK_SPRAY, cellCorner,
                rest + crestHeight, state);
        }
    }
    if (plunge > 0.0) {
        foam += WAVE_PLUNGE_FOAM * seconds;
        if (hits) {
            float fall = sqrt(plunge);
            recordHits(fall * WAVE_PLUNGE_MIST_RATE, WATER_LINK_MIST, cellCorner, rest, state);
            recordHits(fall * WAVE_PLUNGE_SPLASH_RATE, WATER_LINK_SPLASH, cellCorner, rest, state);
        }
    }
    if (hits) {
        // Droplets thrown up where something disturbs the water, recorded by the cell holding
        // the disturbance's middle, spread over its patch
        for (int d = 0; d < disturbanceCount; ++d) {
            vec4 disturbance = disturbanceList.disturbances[d];
            if (any(notEqual(ivec2(floor(disturbance.xy)), local))) {
                continue;
            }
            uint count = min(uint(disturbance.w * disturbance.z * WAVE_CELL_SIZE
                * WAVE_DISTURBANCE_SPLASHES + 0.5), WAVE_MOST_DISTURBANCE_SPLASHES);
            count = max(count, 1u);
            vec2 center = cornerRender + disturbance.xy * WAVE_CELL_SIZE;
            for (uint i = 0; i < count; ++i) {
                float angle = 6.28318530718 * waveRandom(state);
                float reach = disturbance.z * WAVE_CELL_SIZE * sqrt(waveRandom(state));
                vec2 at = center + reach * vec2(cos(angle), sin(angle));
                recordHit(vec3(at.x, rest, at.y), WATER_LINK_SPLASH);
            }
        }
    }
    next.values[slot * WAVE_CELL_VALUES + WAVE_FOAM_BAND * WAVE_DIRECTIONS] = min(foam, 1.0);
    // How hard it rains here, smoothed over WAVE_RAIN_SMOOTHING
    float rain = lastAt(middle, WAVE_FOAM_BAND, WAVE_RAIN_DIRECTION);
    if (seconds > 0.0) {
        float keep = exp(-seconds / WAVE_RAIN_SMOOTHING);
        rain = rain * keep + drops / (WAVE_CELL_SIZE * WAVE_CELL_SIZE) * (1.0 - keep) / seconds;
    }
    next.values[slot * WAVE_CELL_VALUES + WAVE_FOAM_BAND * WAVE_DIRECTIONS + WAVE_RAIN_DIRECTION]
        = rain;
}
