#version 460
#extension GL_EXT_buffer_reference : require

// Picks each level of detail world's cut and culls it. Each thread takes one cluster of one world
// and one pass. A cluster is in the cut by Nanite's rule: its own error, projected to the screen
// from the nearest point of its saturated sphere, is at or under the threshold, and its parent
// group's is over it (LodCullMath has it in Java, with tests). What is in the cut is then tested
// against the pass's frustum, and the scene's against the depth pyramid in two phases, the same
// way cull.comp culls instances:
// - Early, with the shadow cascades: the scene draws what was visible last frame, by the history
//   kept for each cluster. The cascades draw everything in the cut in their frusta, so shadows
//   come from the cut the scene sees.
// - Late, after the pyramid is built: everything in the cut and the frustum is tested against the
//   pyramid, what is visible and wasn't drawn early is drawn now, and the history is updated.
// Each draw is appended to its list's commands with an atomic count, which the draws read as
// their count.
//
// While a live world catches up with its sections, a cell marked stale can't have its clusters
// above the leaves drawn, except to stand in for children that aren't there, a cluster whose
// parent is in a stale cell treats its parent's error as infinite, and a hidden section's leaves
// aren't drawn, since the section draws itself. Without the stand ins, a stale chain of cells up to
// the root left every place whose leaves weren't on the GPU undrawn.
//
// Only some streaming units are on the GPU (see LodResidency): a cluster is drawn only while its
// unit is shown, and while its children's unit isn't, it is drawn whatever its own error, standing
// in for them. Shown units are closed upward, so a cluster's parent is always there.
//
// Threads past the cluster table take the pairs of instances of models: each instance of a model
// picks its own cut from the model's clusters, with the observer in the model's frame and its
// clusters' spheres carried into the world by the instance's turn, scale and place (see
// LodCullMath). Its draws carry its slot and the cluster's index in the model.

// See LodCullMath for the layout
struct Cluster {
    vec4 tight;
    vec4 bound;
    vec4 parentBound;
    // x: error bits, y: parent error bits, z: mesh slot, w: the slot's generation
    uvec4 info;
    // x: world slot + 1 (0 for an empty entry), y: cell slot, z: parent's cell slot (NONE for a
    // root), w: section slot for a leaf (NONE above the leaves)
    uvec4 place;
    // x: streaming unit slot, y: its children's unit slot (NONE for a leaf), z: level, w: flags
    uvec4 unit;
};

// See LodCullMath for the layout
struct World {
    vec4 renderOffset;
    vec4 eye;
    ivec4 cameraGrid;
    vec4 cameraFraction;
    // x: unused, y: 1 if it is drawn, z: threshold bits, w: pixels per unit bits
    uvec4 info;
    // An instance's turn, a quaternion
    vec4 rotation;
    // x: 1 + the model's first cluster entry (0 for a world), y: its cluster count, z: the
    // instance's first pair, w: its material remaps
    uvec4 model;
    uvec4 remapFrom;
    uvec4 remapTo;
};

// See GeometryArena for the layout
struct Mesh {
    // x: vertex offset, y: first index, z: index count (0 if it can't be drawn), w: generation
    uvec4 info;
    vec4 aabbMin;
    vec4 aabbMax;
};

// VkDrawIndexedIndirectCommand
struct Command {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Clusters {
    Cluster clusters[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) buffer History {
    uint history[];
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Meshes {
    Mesh meshes[];
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Worlds {
    World worlds[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Commands {
    Command commands[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Counts {
    uint counts[];
};

// Each cell slot's flags
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer CellFlags {
    uint cellFlags[];
};

// One bit per section slot, set while the section draws itself
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Hidden {
    uint hidden[];
};

// One bit per streaming unit slot, set while the unit's clusters may be drawn
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ShownUnits {
    uint shownUnits[];
};

// Each instance's clusters: x its world slot + 1 (0 for none), y whether it was visible last frame
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Pairs {
    uvec2 pairs[];
};

// The frustum planes of each pass, six per pass, in render space. A point p is inside a plane
// when dot(plane.xyz, p) + plane.w >= 0.
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Frusta {
    vec4 planes[];
};

// What the occlusion test needs, see cull.comp
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer View {
    mat4 projectionView;
    ivec2 size;
    int levels;
    uint flags;
};

// Every level of the depth pyramid, the farthest depth under each texel
layout(set = 0, binding = 0) uniform sampler2D pyramid;

layout(push_constant) uniform Constants {
    Clusters clusterTable;
    History historyTable;
    Meshes meshTable;
    Worlds worldTable;
    Commands commandList;
    Counts countList;
    Frusta frusta;
    View view;
    CellFlags cellFlagTable;
    Hidden hiddenTable;
    ShownUnits shownUnitTable;
    // PHASE_EARLY or PHASE_LATE
    uint phase;
    // How many entries the cluster table has
    uint capacity;
    Pairs pairTable;
    // How many entries the pair table has; each list has room for capacity + pairCapacity commands
    uint pairCapacity;
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// A cluster without triangles
const uint NO_MESH = 0xFFFFFFFFu;

// A cell or section slot that isn't there
const uint NONE = 0xFFFFFFFFu;

// Set in a cell's flags while it is stale
const uint FLAG_STALE = 1;

// The phases, see the top
const uint PHASE_EARLY = 0;
const uint PHASE_LATE = 1;

// The lists, the same as cull.comp's up to the translucent one, see LodRenderer
const uint LIST_SCENE_EARLY = 0;
const uint LIST_SCENE_LATE = 1;
const uint LIST_FIRST_CASCADE = 2;
const uint LIST_COUNT = 6;
// A cut out cluster's draws go to its list plus this, to be drawn with an alpha test
const uint CUT_OUT_LISTS = LIST_COUNT;
// A coverage volume's draws go to its list plus this, to be walked by scene_volume.frag
const uint VOLUME_LISTS = 2 * LIST_COUNT;
const uint LIST_SLOTS = 3 * LIST_COUNT;

// The passes, as in cull.comp: the cascades and the sky map cull clusters by the planes for what
// doesn't move
const uint PASS_COUNT = 5;

// The counters after the lists' counts, see LodRenderer
const uint COUNTER_SELECTED = LIST_SLOTS;
const uint COUNTER_TRIANGLES = LIST_SLOTS + 1;
const uint COUNTER_OUTSIDE = LIST_SLOTS + 2;
const uint COUNTER_OCCLUDED = LIST_SLOTS + 3;
// Then, for each level up to LEVEL_COUNTERS, the cut's clusters, its triangles, and its triangles
// inside the scene's frustum, each level's three together
const uint COUNTER_LEVELS = LIST_SLOTS + 4;
const uint LEVEL_COUNTERS = 32u;
const uint COUNTERS_PER_LEVEL = 3u;

// Set in a cluster's flags, unit.w, when some of its materials are cut out, see LodCullMath
const uint CLUSTER_CUT_OUT = 1;
// Set when it is a coverage volume, its mesh its bricks' boxes
const uint CLUSTER_VOLUME = 2;
// Where a coverage volume cluster's flags keep how many of its mesh's indices are its bricks'
// boxes, the rest its shell's, see LodCullMath.SHELL_SHIFT
const uint SHELL_SHIFT = 8;

// Set in the view flags when the scene is culled by occlusion
const uint FLAG_OCCLUSION = 1;
// Set in the view flags when the pyramid holds a depth buffer
const uint FLAG_PYRAMID_VALID = 2;

// How far in front of the eye in clip space w a box's corners must be for it to be projected
const float MIN_CLIP_W = 1e-5;

// The nearest a sphere is treated as being, so errors stay finite, see LodCullMath
const float MIN_DISTANCE = 1e-6;

// An error projected to the screen from the nearest point of a sphere, see LodCullMath.projected
float projected(float error, vec4 sphere, vec3 eye, float pixelsPerUnit)
{
    if (isinf(error)) {
        return error;
    }
    if (error == 0.0) {
        return 0.0;
    }
    float distance = max(MIN_DISTANCE, length(sphere.xyz - eye) - sphere.w);
    return error * pixelsPerUnit / distance;
}

// Whether a sphere is at least partly inside all six planes of a pass
bool inFrustum(uint pass, vec3 center, float radius)
{
    for (uint i = 0; i < 6; ++i) {
        vec4 plane = frusta.planes[pass * 6 + i];
        if (dot(plane.xyz, center) + plane.w < -radius) {
            return false;
        }
    }
    return true;
}

// The pixel a screen coordinate falls in, kept on screen
int toPixel(float coordinate, int size)
{
    return int(clamp(floor(coordinate), 0.0, float(size - 1)));
}

// The pyramid texel a depth pixel is under at a level, along one axis
int texelAt(int pixel, int size, int level)
{
    return min(pixel >> (level + 1), max(1, size >> (level + 1)) - 1);
}

// Whether a render space box is hidden behind what the pyramid saw, as in cull.comp and
// DepthPyramidMath.occluded
bool occluded(vec3 center, vec3 extents)
{
    vec2 low = vec2(1e30);
    vec2 high = vec2(-1e30);
    float nearest = 1e30;
    for (int i = 0; i < 8; ++i) {
        vec3 sides = vec3(
            (i & 1) == 0 ? -1.0 : 1.0, (i & 2) == 0 ? -1.0 : 1.0, (i & 4) == 0 ? -1.0 : 1.0);
        vec4 clip = view.projectionView * vec4(center + extents * sides, 1.0);
        // Reaching behind the eye, it may be all around it
        if (clip.w <= MIN_CLIP_W) {
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        low = min(low, ndc.xy);
        high = max(high, ndc.xy);
        nearest = min(nearest, ndc.z);
    }

    // Device y points up and pixel rows go down
    ivec2 size = view.size;
    int x0 = toPixel((low.x * 0.5 + 0.5) * float(size.x), size.x);
    int x1 = toPixel((high.x * 0.5 + 0.5) * float(size.x), size.x);
    int y0 = toPixel((0.5 - high.y * 0.5) * float(size.y), size.y);
    int y1 = toPixel((0.5 - low.y * 0.5) * float(size.y), size.y);

    // The finest level where the rectangle is under at most 2 x 2 texels
    int level = 0;
    while (level < view.levels - 1
            && (texelAt(x1, size.x, level) - texelAt(x0, size.x, level) > 1
                || texelAt(y1, size.y, level) - texelAt(y0, size.y, level) > 1)) {
        level += 1;
    }
    float farthest = 0.0;
    for (int y = texelAt(y0, size.y, level); y <= texelAt(y1, size.y, level); ++y) {
        for (int x = texelAt(x0, size.x, level); x <= texelAt(x1, size.x, level); ++x) {
            farthest = max(farthest, texelFetch(pyramid, ivec2(x, y), level).r);
        }
    }
    return nearest > farthest;
}

// Whether a unit slot is shown, units with no slot always being
bool shown(uint unit)
{
    return unit == NONE || (shownUnitTable.shownUnits[unit >> 5] & (1u << (unit & 31u))) != 0;
}

// Whether a cell slot is there and stale
bool stale(uint cell)
{
    return cell != NONE && (cellFlagTable.cellFlags[cell] & FLAG_STALE) != 0;
}

// Append a cluster's mesh to a list's draw commands. Its draw id goes in as the instance: a
// world's cluster's entry, which the vertex shaders read its world, and so their camera, with, or
// an instanced draw's, see LodCullMath.drawId.
void draw(uint list, Mesh mesh, uint drawId)
{
    uint index = atomicAdd(countList.counts[list], 1u);
    Command command;
    command.indexCount = mesh.info.z;
    command.instanceCount = 1;
    command.firstIndex = mesh.info.y;
    command.vertexOffset = int(mesh.info.x);
    command.firstInstance = drawId;
    commandList.commands[list * (capacity + pairCapacity) + index] = command;
}

// See LodCullMath
const uint INSTANCED = 0x80000000u;
const uint INSTANCE_SHIFT = 16;

// Turn a vector by a quaternion
vec3 rotate(vec4 q, vec3 v)
{
    vec3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

// Whether a world's cluster or an instance's pair was visible last frame
bool wasVisible(bool instanced, uint index)
{
    return instanced ? pairTable.pairs[index].y != 0u : historyTable.history[index] != 0u;
}

// Note whether it is visible this frame
void setVisible(bool instanced, uint index, bool visible)
{
    if (instanced) {
        pairTable.pairs[index].y = visible ? 1u : 0u;
    } else {
        historyTable.history[index] = visible ? 1u : 0u;
    }
}

void main()
{
    uint thread = gl_GlobalInvocationID.x;
    // Early, the scene then each cascade; late, only the scene
    uint pass = gl_GlobalInvocationID.y;
    if (thread >= capacity + pairCapacity) {
        return;
    }
    bool instanced = thread >= capacity;
    // The world's cluster's entry, or the instance's pair
    uint index = instanced ? thread - capacity : thread;
    Cluster cluster;
    World w;
    uint drawId;
    if (instanced) {
        uint slot = pairTable.pairs[index].x;
        if (slot == 0) {
            return;
        }
        w = worldTable.worlds[slot - 1];
        // A model not yet applied has no entries
        if (w.model.x == 0) {
            return;
        }
        uint local = index - w.model.z;
        cluster = clusterTable.clusters[w.model.x - 1 + local];
        drawId = INSTANCED | ((slot - 1) << INSTANCE_SHIFT) | local;
    } else {
        cluster = clusterTable.clusters[index];
        if (cluster.place.x == 0) {
            return;
        }
        w = worldTable.worlds[cluster.place.x - 1];
        drawId = index;
    }
    if (w.info.y == 0 || !shown(cluster.unit.x)) {
        if (phase == PHASE_LATE) {
            setVisible(instanced, index, false);
        }
        return;
    }
    // Standing in for children that aren't there
    bool forced = cluster.unit.y != NONE && !shown(cluster.unit.y);

    // In the cut, from the observer
    float threshold = uintBitsToFloat(w.info.z);
    float pixelsPerUnit = uintBitsToFloat(w.info.w);
    bool leaf = cluster.place.w != NONE;
    bool selectable = leaf
        ? (hiddenTable.hidden[cluster.place.w >> 5] & (1u << (cluster.place.w & 31u))) == 0
        : !stale(cluster.place.y) || forced;
    float own = projected(uintBitsToFloat(cluster.info.x), cluster.bound, w.eye.xyz, pixelsPerUnit);
    float parent = stale(cluster.place.z)
        ? uintBitsToFloat(0x7F800000u)
        : projected(uintBitsToFloat(cluster.info.y), cluster.parentBound, w.eye.xyz, pixelsPerUnit);
    bool selected = selectable && (own <= threshold || forced) && parent > threshold;

    // A cluster with no triangles, or one whose mesh isn't there, draws nothing
    bool drawable = cluster.info.z != NO_MESH;
    Mesh mesh;
    if (drawable) {
        mesh = meshTable.meshes[cluster.info.z];
        drawable = mesh.info.w == cluster.info.w && mesh.info.z != 0;
    }
    if (!selected || !drawable) {
        if (phase == PHASE_LATE) {
            setVisible(instanced, index, false);
        }
        return;
    }

    // Cut out clusters go to their lists' cut out share
    uint lists = (cluster.unit.w & CLUSTER_VOLUME) != 0u ? VOLUME_LISTS
        : (cluster.unit.w & CLUSTER_CUT_OUT) != 0u ? CUT_OUT_LISTS : 0u;
    // A coverage volume with a shell after its boxes is drawn as the shell, alpha tested with the
    // cut outs, once its sphere is small on screen (the world's eye.w, in pixels), else as the boxes
    uint boxIndices = cluster.unit.w >> SHELL_SHIFT;
    if ((cluster.unit.w & CLUSTER_VOLUME) != 0u && boxIndices > 0u && boxIndices < mesh.info.z) {
        float pixels = cluster.tight.w * pixelsPerUnit
            / max(length(cluster.tight.xyz - w.eye.xyz), 1e-6);
        if (pixels < w.eye.w) {
            lists = CUT_OUT_LISTS;
            mesh.info.y += boxIndices;
            mesh.info.z -= boxIndices;
        } else {
            mesh.info.z = boxIndices;
        }
    }

    // An instance's spheres are in the model's frame, its scale in renderOffset.w
    vec3 center = instanced
        ? rotate(w.rotation, cluster.tight.xyz * w.renderOffset.w) + w.renderOffset.xyz
        : cluster.tight.xyz + w.renderOffset.xyz;
    float radius = instanced ? cluster.tight.w * w.renderOffset.w : cluster.tight.w;
    // Clusters never move, so a cascade culls them by its planes for what doesn't move; instances
    // that move mark where they were and are as changed, see LodRenderer
    bool inView = inFrustum(pass > 0 ? PASS_COUNT + pass : pass, center, radius);

    if (phase == PHASE_EARLY) {
        if (pass == 0) {
            atomicAdd(countList.counts[COUNTER_SELECTED], 1u);
            atomicAdd(countList.counts[COUNTER_TRIANGLES], mesh.info.z / 3u);
            uint levelCounters = COUNTER_LEVELS
                + min(cluster.unit.z, LEVEL_COUNTERS - 1u) * COUNTERS_PER_LEVEL;
            atomicAdd(countList.counts[levelCounters], 1u);
            atomicAdd(countList.counts[levelCounters + 1u], mesh.info.z / 3u);
            if (inView) {
                atomicAdd(countList.counts[levelCounters + 2u], mesh.info.z / 3u);
            }
            if (!inView) {
                atomicAdd(countList.counts[COUNTER_OUTSIDE], 1u);
                return;
            }
            // With occlusion on, what wasn't visible last frame waits for the late test
            if ((view.flags & FLAG_OCCLUSION) == 0 || wasVisible(instanced, index)) {
                draw(lists + LIST_SCENE_EARLY, mesh, drawId);
            }
        } else if (inView) {
            draw(lists + LIST_FIRST_CASCADE + pass - 1, mesh, drawId);
        }
        return;
    }

    bool seen = inView;
    if (seen && (view.flags & FLAG_PYRAMID_VALID) != 0 && occluded(center, vec3(radius))) {
        seen = false;
        atomicAdd(countList.counts[COUNTER_OCCLUDED], 1u);
    }
    bool drawnEarly = wasVisible(instanced, index);
    setVisible(instanced, index, seen);
    if (seen && !drawnEarly) {
        draw(lists + LIST_SCENE_LATE, mesh, drawId);
    }
}
