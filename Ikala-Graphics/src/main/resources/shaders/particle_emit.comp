#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require

// Spawns this frame's particles, see ParticleUpdate: one thread per spawn, over every emitter's
// spawns in turn. Each takes a particle off the free list, or counts as dropped when the pool is
// full, and adds it to the alive list the simulation just wrote, so it is drawn this frame. A
// linked emitter with a box spawns in it rather than a ball, and one around the camera spawns
// nothing under cover.

#include "particles.glsl"
#include "particle_cover.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer EmitterList {
    Emitter emitters[];
};

layout(push_constant) uniform Constants {
    ParticleBuffer pool;
    IndexList to;
    IndexList dead;
    Control control;
    EmitterList emitterList;
    LinkList linkList;
    // How many emitters spawn this frame, and how many particles in all
    uint emitterCount;
    uint total;
    // Which alive list the simulation just wrote
    uint next;
};

// The emitter whose spawns hold an index, by binary search over their first spawns
uint findEmitter(uint spawn) {
    uint low = 0;
    uint high = emitterCount - 1;
    while (low < high) {
        uint middle = (low + high + 1) / 2;
        if (emitterList.emitters[middle].firstSpawn <= spawn) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    return low;
}

void main() {
    uint spawn = gl_GlobalInvocationID.x;
    if (spawn >= total) {
        return;
    }
    Emitter emitter = emitterList.emitters[findEmitter(spawn)];
    uint seed = particleHash(emitter.seed ^ particleHash(spawn));

    vec3 position = emitter.position;
    uint link = behaviorLink(emitter.behavior);
    if (link != 0u && any(greaterThan(linkList.links[link - 1].halfSize, vec3(0.0)))) {
        vec3 halfSize = linkList.links[link - 1].halfSize;
        position += (vec3(particleRandom(seed), particleRandom(seed), particleRandom(seed)) * 2.0
            - 1.0) * halfSize;
    } else {
        position += ballOffset(emitter.sizes.w, seed);
    }
    if (link != 0u && linkList.links[link - 1].center.w != 0.0
            && coverDepth(linkList, position) > COVER_BIAS) {
        // Under cover: rain doesn't fall indoors
        return;
    }

    int free = atomicAdd(control.dead, -1);
    if (free <= 0) {
        atomicAdd(control.dead, 1);
        atomicAdd(control.dropped, 1);
        return;
    }
    uint slot = dead.indices[free - 1];
    Particle particle = newParticle(emitter, position, seed);
    pool.particles[slot] = particle;
    to.indices[atomicAdd(control.alive[next], 1)] = slot;
    if (behaviorVolumetric(particle.behavior)) {
        atomicAdd(control.counts.x, 1);
    }
}
