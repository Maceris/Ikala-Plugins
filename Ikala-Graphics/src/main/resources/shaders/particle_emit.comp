#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require

// Spawns this frame's particles, see ParticleUpdate: one thread per spawn, over every emitter's
// spawns in turn. Each takes a particle off the free list, or counts as dropped when the pool is
// full, and adds it to the alive list the simulation just wrote, so it is drawn this frame.

#include "particles.glsl"

layout(local_size_x = 64) in;

// One emitter's spawns this frame, ParticleMath.EMITTER_SIZE bytes, its position relative to the
// anchor and its first spawn's index among the frame's
struct Emitter {
    vec3 position;
    uint firstSpawn;
    vec3 direction;
    float cosSpread;
    vec3 acceleration;
    float drag;
    // Lifetime's range, then speed's
    vec4 lifetimeSpeed;
    vec4 colorStart;
    vec4 colorEnd;
    // Size at birth and death, emission, and the spawn ball's radius
    vec4 sizes;
    uint spawnCount;
    uint seed;
    uint padding0;
    uint padding1;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer EmitterList {
    Emitter emitters[];
};

layout(push_constant) uniform Constants {
    ParticleBuffer pool;
    IndexList to;
    IndexList dead;
    Control control;
    EmitterList emitterList;
    // How many emitters spawn this frame, and how many particles in all
    uint emitterCount;
    uint total;
    // Which alive list the simulation just wrote
    uint next;
};

// The emitter whose spawns hold an index, by binary search over their first spawns
uint findEmitter(uint spawn) {
    uint low = 0;
    uint high = emitterCount - 1;
    while (low < high) {
        uint middle = (low + high + 1) / 2;
        if (emitterList.emitters[middle].firstSpawn <= spawn) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    return low;
}

void main() {
    uint spawn = gl_GlobalInvocationID.x;
    if (spawn >= total) {
        return;
    }
    int free = atomicAdd(control.dead, -1);
    if (free <= 0) {
        atomicAdd(control.dead, 1);
        atomicAdd(control.dropped, 1);
        return;
    }
    uint slot = dead.indices[free - 1];
    Emitter emitter = emitterList.emitters[findEmitter(spawn)];
    uint seed = particleHash(emitter.seed ^ particleHash(spawn));

    // Even in a ball: a direction, and a radius by the cube root for even volume
    vec3 offset = coneDirection(vec3(0.0, 1.0, 0.0), -1.0, particleRandom(seed),
        particleRandom(seed)) * (emitter.sizes.w * pow(particleRandom(seed), 1.0 / 3.0));
    vec3 direction = coneDirection(emitter.direction, emitter.cosSpread, particleRandom(seed),
        particleRandom(seed));
    float speed = mix(emitter.lifetimeSpeed.z, emitter.lifetimeSpeed.w, particleRandom(seed));

    Particle particle;
    particle.position = emitter.position + offset;
    particle.age = 0.0;
    particle.velocity = direction * speed;
    particle.lifetime = mix(emitter.lifetimeSpeed.x, emitter.lifetimeSpeed.y, particleRandom(seed));
    particle.acceleration = emitter.acceleration;
    particle.drag = emitter.drag;
    particle.colorStart = packParticleColor(emitter.colorStart);
    particle.colorEnd = packParticleColor(emitter.colorEnd);
    particle.sizeStart = emitter.sizes.x;
    particle.sizeEnd = emitter.sizes.y;
    particle.emissive = emitter.sizes.z;
    particle.seed = seed;
    pool.particles[slot] = particle;
    to.indices[atomicAdd(control.alive[next], 1)] = slot;
}
